<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  NOTE: "com.clientdeck.app" is a placeholder reverse-DNS id — replace it
  (and the matching Exec/annotate path below) with your actual domain
  before shipping. The org.freedesktop.policykit.exec.path annotation must
  point at the exact installed absolute path of create_user.py (or its
  packaged single-file equivalent), since pkexec authorizes by exact path;
  this is left for the install/self-registration step to fill in, since
  that path isn't known until the app is actually installed.
-->
<policyconfig>
  <vendor>ClientDeck</vendor>
  <action id="com.clientdeck.app.manage-users">
    <description>Create an isolated Linux user for a ClientDeck client</description>
    <message>Authentication is required to create a new client user account</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/python3</annotate>
  </action>
</policyconfig>
